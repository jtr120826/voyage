<Window x:Class="Reiseplaner.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reiseplaner – Anmeldung" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock x:Name="UeberschriftText" Text="Anmelden" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock x:Name="HinweisText" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10"/>

        <TextBlock Text="Benutzername" Margin="0,4,0,2"/>
        <TextBox x:Name="BenutzernameBox"/>

        <TextBlock Text="Passwort" Margin="0,8,0,2"/>
        <PasswordBox x:Name="PasswortBox"/>

        <StackPanel x:Name="WiederholenPanel" Visibility="Collapsed">
            <TextBlock Text="Passwort wiederholen" Margin="0,8,0,2"/>
            <PasswordBox x:Name="PasswortWiederholenBox"/>
        </StackPanel>

        <TextBlock x:Name="FehlerText" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="AnmeldenButton" Content="Anmelden" Width="110" IsDefault="True"
                    Margin="0,0,6,0" Click="AnmeldenButton_Click"/>
            <Button x:Name="BeendenButton" Content="Beenden" Width="90" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
