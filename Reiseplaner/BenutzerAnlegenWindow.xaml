<Window x:Class="Reiseplaner.BenutzerAnlegenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Benutzer anlegen" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Neuen Benutzer anlegen" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBlock Text="Benutzername" Margin="0,4,0,2"/>
        <TextBox x:Name="BenutzernameBox"/>

        <TextBlock Text="Passwort" Margin="0,8,0,2"/>
        <PasswordBox x:Name="PasswortBox"/>

        <TextBlock Text="Passwort wiederholen" Margin="0,8,0,2"/>
        <PasswordBox x:Name="PasswortWiederholenBox"/>

        <TextBlock Text="Rolle" Margin="0,8,0,2"/>
        <ComboBox x:Name="RolleBox"/>

        <TextBlock x:Name="MeldungText" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="AnlegenButton" Content="Anlegen" Width="100" IsDefault="True"
                    Margin="0,0,6,0" Click="AnlegenButton_Click"/>
            <Button x:Name="SchliessenButton" Content="Schliessen" Width="90" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
