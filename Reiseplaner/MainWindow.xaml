<Window x:Class="Reiseplaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reiseplaner" Height="650" Width="1350">
    <Window.Resources>
        <!-- Platzhaltertext (Watermark) für eine TextBox: eine TextBlock liegt als Overlay über der
             TextBox (unverändertes Standard-Template!) und ist nur sichtbar, solange die TextBox leer ist. -->
        <Style x:Key="PlatzhalterOverlay" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </Window.Resources>
    <DockPanel>
    <!-- Kopfzeile: angemeldeter Benutzer, Abmelden und (nur Administratoren) Benutzer anlegen -->
    <Border DockPanel.Dock="Top" Padding="10,6" Background="#FFF0F0F0" BorderBrush="LightGray" BorderThickness="0,0,0,1">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BenutzerAnlegenButton" Content="Benutzer anlegen" Padding="10,2"
                        Margin="0,0,6,0" Click="BenutzerAnlegenButton_Click"/>
                <Button x:Name="AbmeldenButton" Content="Abmelden" Padding="10,2" Click="AbmeldenButton_Click"/>
            </StackPanel>
            <TextBlock x:Name="BenutzerText" VerticalAlignment="Center"/>
        </DockPanel>
    </Border>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="700"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Linke Spalte: Reisen -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Reisen" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>

            <DataGrid x:Name="ReisenGrid" Grid.Row="1" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single"
                      SelectionChanged="ReisenGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Titel" Binding="{Binding Titel}" Width="90"/>
                    <DataGridTextColumn Header="Zielort" Binding="{Binding Zielort}" Width="90"/>
                    <DataGridTextColumn Header="Start" Binding="{Binding Startdatum}" Width="80"/>
                    <DataGridTextColumn Header="Ende" Binding="{Binding Enddatum}" Width="80"/>
                    <DataGridTextColumn Header="Budget" Binding="{Binding Budget, StringFormat={}{0:C}}" Width="90"/>
                    <DataGridTextColumn Header="Geplantes Budget" Binding="{Binding GeplantesBudget, StringFormat={}{0:C}}" Width="120"/>
                    <DataGridTextColumn Header="Verbleibendes Budget" Binding="{Binding VerbleibendesBudget, StringFormat={}{0:C}}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock x:Name="ReiseFormularTitel" Text="Neue Reise" FontWeight="Bold" Margin="0,0,0,4"/>

                <Grid Margin="0,2">
                    <TextBox x:Name="TitelBox" TextChanged="PlatzhalterAktualisieren"/>
                    <TextBlock x:Name="TitelPlatzhalter" Text="Reisetitel" Style="{StaticResource PlatzhalterOverlay}"/>
                </Grid>
                <Grid Margin="0,2">
                    <TextBox x:Name="ZielortBox" TextChanged="PlatzhalterAktualisieren"/>
                    <TextBlock x:Name="ZielortPlatzhalter" Text="Zielort" Style="{StaticResource PlatzhalterOverlay}"/>
                </Grid>
                <DatePicker x:Name="StartPicker" Margin="0,2"/>
                <DatePicker x:Name="EndePicker" Margin="0,2"/>
                <Grid Margin="0,2">
                    <TextBox x:Name="BudgetBox" TextChanged="PlatzhalterAktualisieren"/>
                    <TextBlock x:Name="BudgetPlatzhalter" Text="Budget (CHF)" Style="{StaticResource PlatzhalterOverlay}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="ReiseSpeichernButton" Content="Hinzufügen" Width="100"
                            Margin="0,0,6,0" Click="ReiseSpeichernButton_Click"/>
                    <Button x:Name="ReiseBearbeitenButton" Content="Bearbeiten" Width="100"
                            Margin="0,0,6,0" Click="ReiseBearbeitenButton_Click"/>
                    <Button x:Name="ReiseLoeschenButton" Content="Löschen" Width="100"
                            Margin="0,0,6,0" Click="ReiseLoeschenButton_Click"/>
                    <Button x:Name="ReiseAbbrechenButton" Content="Abbrechen" Width="100"
                            Visibility="Collapsed" Click="ReiseAbbrechenButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Rechte Spalte: Programmpunkte -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Programmpunkte" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>

            <TextBlock x:Name="BudgetInfoText" Grid.Row="1" FontSize="14" Margin="0,0,0,8"/>

            <DataGrid x:Name="ProgrammGrid" Grid.Row="2" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Erledigt" Binding="{Binding Erledigt}" Width="60"/>
                    <DataGridTextColumn Header="Titel" Binding="{Binding Titel}" Width="*"/>
                    <DataGridTextColumn Header="Datum" Binding="{Binding Datum}" Width="80"/>
                    <DataGridTextColumn Header="Kategorie" Binding="{Binding Kategorie}" Width="110"/>
                    <DataGridTextColumn Header="Kosten" Binding="{Binding Kosten}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                <TextBlock x:Name="PunktFormularTitel" Text="Neuer Programmpunkt" FontWeight="Bold" Margin="0,0,0,4"/>

                <Grid Margin="0,2">
                    <TextBox x:Name="PunktTitelBox" TextChanged="PlatzhalterAktualisieren"/>
                    <TextBlock x:Name="PunktTitelPlatzhalter" Text="Programmpunkt-Titel" Style="{StaticResource PlatzhalterOverlay}"/>
                </Grid>
                <DatePicker x:Name="PunktDatumPicker" Margin="0,2"/>
                <ComboBox x:Name="KategorieBox" Margin="0,2"/>
                <Grid Margin="0,2">
                    <TextBox x:Name="KostenBox" TextChanged="PlatzhalterAktualisieren"/>
                    <TextBlock x:Name="KostenPlatzhalter" Text="Kosten (CHF)" Style="{StaticResource PlatzhalterOverlay}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="PunktSpeichernButton" Content="Hinzufügen" Width="100"
                            Margin="0,0,6,0" Click="PunktSpeichernButton_Click"/>
                    <Button x:Name="PunktBearbeitenButton" Content="Bearbeiten" Width="100"
                            Margin="0,0,6,0" Click="PunktBearbeitenButton_Click"/>
                    <Button x:Name="ErledigtButton" Content="Erledigt umschalten" Width="150"
                            Margin="0,0,6,0" Click="ErledigtButton_Click"/>
                    <Button x:Name="PunktLoeschenButton" Content="Löschen" Width="100"
                            Margin="0,0,6,0" Click="PunktLoeschenButton_Click"/>
                    <Button x:Name="PunktAbbrechenButton" Content="Abbrechen" Width="100"
                            Visibility="Collapsed" Click="PunktAbbrechenButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
    </DockPanel>
</Window>
